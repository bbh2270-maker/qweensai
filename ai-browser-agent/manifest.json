{
  "manifest_version": 3,
  "name": "AI Browser Agent",
  "version": "2.0.0",
  "description": "Autonomous AI agent that opens tabs and completes web tasks (click, type, navigate) using Gemini, Claude, Groq or OpenRouter APIs",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Browser Agent"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
